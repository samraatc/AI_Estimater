# ================================================================
# EstimateOS Backend — Environment Variables (.env.example)
# ================================================================

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ── JWT Authentication ────────────────────────────────────────────
JWT_SECRET=dev_CHANGE_ME_use_openssl_rand_base64_64
JWT_EXPIRY=15m
REFRESH_TOKEN_DAYS=30

# ── Database (MongoDB Atlas / Render Mongo / Local Mongo) ─────────
MONGODB_URI=mongodb://localhost:27017/estimateos

# ── Redis (Docker: REDIS_HOST=redis, Local: REDIS_HOST=localhost) ─
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ── OpenAI Configuration ──────────────────────────────────────────
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
OPENAI_PRIMARY_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=8000
OPENAI_TEMPERATURE=0.1

# ── Cloudinary Storage (Recommended for Vercel / Render) ─────────
# Get free credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or use full URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── MinIO / S3 Storage (Fallback for local Docker dev) ───────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ── Email Service (Optional) ──────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@estimateos.com
EMAIL_SECURE=false

# ── Miscellaneous ─────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
QUEUE_CONCURRENCY=3
